{
  "name": "patpat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "build:pages": "vite build --outDir docs --emptyOutDir && node -e \"require('fs').writeFileSync('docs/.nojekyll','')\"",
    "check:camera": "node scripts/check-camera-clearance.mjs",
    "check:visuals": "node scripts/check-governor.mjs && node scripts/check-fx.mjs && node scripts/check-look.mjs && node scripts/check-shaders.mjs",
    "check:audio": "node scripts/check-audio.mjs",
    "check:ui": "node scripts/check-ui-math.mjs",
    "check:feel": "node scripts/check-feel.mjs && node scripts/check-feel-sim.mjs",
    "check": "npm run check:camera && npm run check:visuals && npm run check:audio && npm run check:ui && npm run check:feel"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "peerjs": "^1.5.5",
    "three": "^0.186.1",
    "trystero": "^0.26.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "vite": "^8.3.2"
  }
}
